<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IndvDoorbellActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/IndvDoorbellHeaderFragment"
        android:name="com.example.knockly.PageHeaderFragment"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/FeedHistoryButton"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="1dp"
        android:text="Doorbell Feed History"
        app:layout_constraintBottom_toTopOf="@+id/ManageFaceProfsButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/ManageDoorbellButton"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="152dp"
        android:text="Manage Doorbell"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/ManageFaceProfsButton"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="60dp"
        android:text="Manage Face Profiles"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/ManageUserProfsButton"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginStart="84dp"
        android:layout_marginBottom="60dp"
        android:text="Manage User Profiles"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/DoorbellLogsButton"
        android:layout_width="246dp"
        android:layout_height="47dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="81dp"
        android:layout_marginBottom="4dp"
        android:text="Doorbell Logs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>