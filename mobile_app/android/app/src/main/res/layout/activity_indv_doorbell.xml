<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".indvDoorbellPage.IndvDoorbellActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/IndvDoorbellHeaderFragment"
        android:name="com.example.knockly.shared.PageHeaderFragment"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/LiveFeedContainer"
        android:name="com.example.knockly.indvDoorbellPage.LiveFeedFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toTopOf="@+id/ManageFaceProfsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/IndvDoorbellHeaderFragment" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/DoorControlContainer"
        android:name="com.example.knockly.indvDoorbellPage.DoorControlFragment"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/LiveFeedContainer" />

    <Button
        android:id="@+id/FeedHistoryButton"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:text="Doorbell Feed History"
        app:layout_constraintBottom_toTopOf="@+id/DoorbellLogsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ManageFaceProfsButton" />

    <Button
        android:id="@+id/ManageDoorbellButton"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="10dp"
        android:text="Manage Doorbell"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/DoorbellLogsButton"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/ManageFaceProfsButton"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="10dp"
        android:text="Manage Face Profiles"
        app:layout_constraintBottom_toTopOf="@+id/ManageDoorbellButton"
        app:layout_constraintEnd_toStartOf="@+id/FeedHistoryButton"
        app:layout_constraintStart_toEndOf="@+id/ManageUserProfsButton" />

    <Button
        android:id="@+id/ManageUserProfsButton"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="10dp"
        android:text="Manage User Profiles"
        app:layout_constraintBottom_toTopOf="@+id/ManageDoorbellButton"
        app:layout_constraintEnd_toStartOf="@+id/ManageFaceProfsButton"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/DoorbellLogsButton"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:text="Doorbell Logs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ManageDoorbellButton" />

</androidx.constraintlayout.widget.ConstraintLayout>